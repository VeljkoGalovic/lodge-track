datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  MAINTENANCE
}

enum SubscriptionTier {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  /// Lemon Squeezy reports `paused` distinctly from `cancelled`; a paused
  /// subscription keeps its data and can resume, so it is not folded into
  /// CANCELED.
  PAUSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

/**
 * What a stay claims.
 *
 * WHOLE_UNIT is the pre-existing behaviour: one row owns the property (or, on a
 * property with units and shared bookings off, one named unit). SHARED_BED only
 * exists on a property with `allowSharedBookings` and claims the specific beds
 * listed in `bedIds`, leaving the rest of the capacity open to other guests.
 */
enum BookingType {
  WHOLE_UNIT
  SHARED_BED
}

/**
 * Module that owns an attachment. Used for polymorphic relations and bucket organization.
 */
enum AttachmentModule {
  EXPENSE
  BOOKING
  PROPERTY
  UNIT
  USER_AVATAR
}

/**
 * What an expense was for. A closed enum rather than free text so the expense
 * list can group and total by category without the totals fragmenting across
 * "utilities", "Utilities" and "utility".
 */
enum ExpenseCategory {
  MAINTENANCE
  UTILITIES
  SUPPLIES
  CLEANING
  TAXES
  INSURANCE
  OTHER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /**
   * ISO 4217 code for every monetary amount in this organization. Bookings
   * store minor units (cents) with no currency of their own, so this is the
   * single place the app decides how to render them.
   */
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenancy relations
  users        User[]
  properties   Property[]
  units        PropertyUnit[]
  expenses     Expense[]
  subscription Subscription?
  invitations  Invitation[]
  attachments  Attachment[]
  apiKeys      ApiKey[]
}

/**
 * The member's interface theme.
 *
 * `SYSTEM` is a real third state, not a synonym for one of the others: it means
 * "follow the operating system", which is a preference the browser has to be
 * asked about at render time. Storing it lets a member choose a theme on a phone
 * set to light and have it stay light, while a second member on the same
 * database keeps following their own system.
 */
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String?
  role         Role          @default(OWNER)

  /**
   * Interface language (ISO 639-1). Stored per member rather than per
   * organization: two people in one organization can read different languages,
   * and nothing about this app's data is language-specific.
   *
   * Deliberately a plain String, not an enum. The set of languages is a product
   * decision that changes far more often than the set of booking statuses, and an
   * enum would make each new language a database migration. The accepted values
   * live in lib/i18n/locales.ts, which is the only thing that reads this field.
   */
  locale       String        @default("en")
  theme        ThemePreference @default(SYSTEM)

  /**
   * TOTP second factor. The secret is encrypted at rest (AES-256-GCM, key
   * derived from AUTH_SECRET) — see lib/crypto.ts. `twoFactorEnabled` is only
   * set once the member has proved they can generate a valid code, so a
   * half-finished setup can never lock anyone out.
   */
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  /**
   * When the user accepted the Terms of Service and Privacy Policy.
   * Required for legal compliance - registration cannot complete without this.
   */
  termsAcceptedAt DateTime?

  /**
   * When the user verified their email address via the verification link.
   * Null means the email is not yet verified.
   */
  emailVerified DateTime?

  // Which kinds of event this member wants to see in the activity feed.
  notifyCheckInsDue Boolean @default(true)
  notifyStaysEnding Boolean @default(true)
  notifyMissingRate Boolean @default(true)

  // Organization scoping
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sentInvitations Invitation[] @relation("InvitationSender")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  legalConsents  LegalConsent[]
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  createdApiKeys    ApiKey[]

  @@index([orgId])
}

/**
 * Records a user's acceptance of legal documents for compliance.
 * Created when a user registers and accepts the Terms of Service and Privacy Policy.
 */
model LegalConsent {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tosVersion           String
  privacyPolicyVersion String
  consentTimestamp     DateTime @default(now())
  ipAddress            String
  userAgent            String
  createdAt            DateTime @default(now())

  @@index([userId])
}

/**
 * One-time tokens for email verification and password reset.
 * Separate from Invitation which is for team joins.
 * Each token is single-use, expires, and is scoped to a purpose.
 */
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  purpose   String   // "email_verification" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

/**
 * A one-time invitation link. The token is the only credential needed to join,
 * so it is single-use (`acceptedAt`), expires, and can be revoked — the accept
 * page refuses a token that is any of those.
 */
model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  role      Role     @default(MANAGER)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([email])
}

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  organization         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /**
   * Payment-provider identifiers. Lemon Squeezy is the provider; the names are
   * deliberately provider-neutral so swapping it later is a code change, not a
   * data migration. All nullable: an organization sits on the free STARTER tier
   * from registration and may never have been through a checkout at all.
   */
  billingCustomerId     String?            @unique
  billingSubscriptionId String?            @unique
  /// Lemon Squeezy variant id of the purchased plan.
  billingVariantId      String?

  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(ACTIVE)

  // Custom Overrides (For beta users, special enterprise deals, or free passes)
  maxPropertiesOverride Int?               // Null = use tier default, e.g., 999999 for unlimited
  hasApiAccessOverride  Boolean?           // Override feature flags manually
  isLifetimeFree        Boolean            @default(false)

  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

/**
 * Idempotency ledger for billing webhooks. Lemon Squeezy retries deliveries and
 * can deliver the same event more than once, so each event id is recorded and
 * replays are dropped rather than applied twice.
 */
model WebhookEvent {
  id         String   @id
  provider   String   @default("lemonsqueezy")
  type       String
  receivedAt DateTime @default(now())
}

/**
 * API Key for programmatic access to the v1 API.
 * The key itself is never stored — only its SHA-256 hash.
 * The prefix (first 8 chars of the raw key) is stored for identification.
 */
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique  // SHA-256 hash of the full key
  keyPrefix   String   @unique  // First 8 chars of raw key (e.g., "lt_live_")
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([createdById])
}

/**
 * Rate limiting for auth endpoints.
 * Tracks attempts per identifier (IP/email) and action.
 * Used to prevent brute-force and enumeration attacks.
 */
model RateLimit {
  id        String   @id @default(cuid())
  identifier String  // IP address or "email:user@example.com"
  action    String   // "register", "login", "password_reset", "email_verification", "two_factor"
  createdAt DateTime @default(now())

  @@index([identifier, action])
  @@index([createdAt])
}

model Property {
  id        String    @id @default(cuid())
  name      String
  address   String
  icalUrl   String?
  currency  String?   // Overrides Organization.currency for this property

  /**
   * Opt-in switch for coliving/hostel-style capacity booking.
   *
   * Off (the default) the app behaves exactly as before: whole-unit
   * reservations only, and the bed-level picker never appears in the UI. On,
   * the property's units become bed *slots* — they are no longer offered as
   * standalone bookable choices; the booking form instead offers an exclusive
   * whole-property stay or a multi-bed shared stay validated against total
   * capacity.
   */
  allowSharedBookings Boolean @default(false)

  // Property belongs to Organization now, not individual User
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  bookings  Booking[]
  units     PropertyUnit[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/**
 * A bookable sub-unit of a property — a room, a bed, a cabin, a pitch.
 *
 * A property with no units is booked whole, which is exactly how every booking
 * behaved before this model existed: `Booking.unitId` is null and the stay claims
 * the entire property. Adding units is therefore opt-in per property and needs no
 * change to the bookings already on it.
 *
 * A property with units is booked per unit: two stays in *different* units of the
 * same property do not conflict, which is the whole point of dividing it up. See
 * lib/availability.ts for the conflict rule.
 *
 * `orgId` is denormalised from the owning property so expense and availability
 * reads can be scoped by tenant without a join. It is never accepted from a
 * request — only ever written from a property row that was itself fetched by
 * `orgId`, so the two cannot disagree.
 */
model PropertyUnit {
  id         String   @id @default(cuid())
  name       String
  /** Free-text kind for grouping in the UI: "Room", "Bed", "Cabin". */
  kind       String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  bookings   Booking[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Two units of one property cannot share a name — "Room 1" twice would make
  /// the booking form's unit picker ambiguous.
  @@unique([propertyId, name])
  @@index([orgId])
}

model Booking {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /**
   * The sub-unit this stay occupies, or null for the whole property.
   *
   * Null is the pre-existing behaviour and stays the default: a property nobody
   * has divided up has exactly one bookable thing, itself.
   *
   * `SetNull` rather than `Restrict` so deleting a property cannot trip over the
   * unit its own bookings point at — those bookings are being cascade-deleted in
   * the same statement. Deleting a unit *on its own* is refused in the action
   * layer while bookings reference it, so this never silently widens a booking
   * into the whole property behind the user's back.
   *
   * On a shared-bookings property this names the *first* bed of a SHARED_BED
   * stay, kept in sync with `bedIds` for backwards-compatible joins and reads;
   * a WHOLE_UNIT stay leaves it null — exclusivity is carried by `type`, not by
   * which rows happen to point somewhere.
   */
  unitId     String?
  unit       PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /**
   * What this stay claims — see the `BookingType` enum.
   *
   * A whole-property/exclusive stay takes every bed slot out at once; a
   * SHARED_BED stay takes exactly the beds in `bedIds`. Defaults to WHOLE_UNIT,
   * which is every booking that existed before shared bookings did.
   */
  type       BookingType @default(WHOLE_UNIT)

  /**
   * The specific bed slots a SHARED_BED stay holds.
   *
   * A scalar Postgres array rather than a join table: the list is only ever
   * read whole, its length is the bed count of the stay, and the ids are
   * `PropertyUnit` ids denormalised here so an availability scan is one query
   * instead of a join. Always empty for WHOLE_UNIT stays.
   *
   * Capacity is validated transactionally at write time (the count of claimed
   * beds must fit the property's free slots), so no uniqueness constraint can
   * express the rule — two SHARED_BED stays may each hold "bed-2" only while a
   * whole-property stay does not also cover those dates, which is exactly the
   * case the check exists for.
   */
  bedIds     String[] @default([])

  guestName    String
  startDate    DateTime
  endDate      DateTime
  source       String   @default("Direct")
  status       BookingStatus @default(PENDING)
  externalUid  String?
  /*
    Total booking value in the smallest currency unit (cents).
    Nullable on purpose: revenue metrics sum this and skip nulls rather than
    falling back to an estimate, so an unrecorded rate shows as "—" instead of
    presenting a fabricated figure as real.
  */
  totalAmount  Int?
  createdAt    DateTime @default(now())

  /// Availability scans filter one property to an overlapping date window.
  @@index([propertyId, startDate, endDate])
  @@index([unitId])
  @@unique([propertyId, externalUid])
}

/*
 * Migration note for shared bookings.
 *
 * Nothing is backfilled: every existing row keeps `WHOLE_UNIT` with empty
 * `bedIds` and every existing property keeps `allowSharedBookings = false`, so
 * the pre-refactor meaning of every row is unchanged. A property that opts in
 * later already lists its capacity as "Bed N" units (the bed-count feature), so
 * turning the flag on reinterprets those rows as slots with no data migration.

/**
 * A cost incurred against a property — maintenance, utilities, supplies.
 *
 * `amount` is minor units in the organization's own currency, the same convention
 * `Booking.totalAmount` uses, so both render through lib/currency.ts and neither
 * can drift into being read as a different currency than the other.
 *
 * The receipt is stored as a private storage key, not a public URL. Receipts name
 * suppliers and prices and sometimes carry card fragments; a file under `public/`
 * would be readable by anyone who can guess or be shown the path, with no session
 * and no tenant check. `receiptPath` names a file outside the served tree that
 * only /api/receipts/[id] will hand back, after confirming the caller belongs to
 * this organization. See lib/storage.ts.
 */
model Expense {
  id          String          @id @default(cuid())
  amount      Int
  category    ExpenseCategory @default(OTHER)
  date        DateTime
  description String

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /** Denormalised from the property, written only from a row already scoped by orgId. */
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  receiptPath String?
  /** The uploader's own filename, kept for the download prompt and never used as a path. */
  receiptName String?
  /** Verified from the file's own bytes on upload, not from the browser's claim. */
  receiptType String?
  receiptSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, date])
  @@index([propertyId, date])
  /// Serves the storage-cap check, which sums every receipt in one organization
  /// before accepting an upload. Leading `orgId` scopes it; `receiptSize` makes
  /// it an index-only scan, so the check costs no heap reads.
  @@index([orgId, receiptSize])

  // Legacy receipt fields (kept for migration period, already defined above)
  // receiptPath String?
  // receiptName String?
  // receiptType String?
  // receiptSize Int?

  // New unified attachments
  attachments Attachment[] @relation("ExpenseAttachments")
}

/**
 * Unified attachment record for all file uploads across modules.
 * Replaces the legacy per-model receipt fields with a polymorphic relation.
 */
model Attachment {
  id            String           @id @default(cuid())
  module        AttachmentModule
  moduleId      String           // References expense.id, booking.id, property.id, etc.

  orgId         String
  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Supabase Storage metadata
  bucket        String           @default("attachments")
  objectPath    String           // e.g., "org_abc/expenses/uuid.pdf"
  supabaseId    String?          // Supabase object ID for management API

  // File metadata (mirrors current receipt fields)
  fileName      String           // Original filename (sanitized)
  mimeType      String           // Sniffed from magic bytes
  fileSize      Int              // Bytes
  checksum      String?          // SHA256 for deduplication/integrity

  // Optional context
  description   String?
  uploadedById  String
  uploadedBy    User             @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  // Inverse relations for polymorphic attachments
  expense       Expense?         @relation("ExpenseAttachments", fields: [moduleId], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgId, module, moduleId])
  @@index([orgId, createdAt])
  @@index([orgId, fileSize])     // For quota sums (index-only scan)
}