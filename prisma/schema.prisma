datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  MAINTENANCE
}

enum SubscriptionTier {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  /// Lemon Squeezy reports `paused` distinctly from `cancelled`; a paused
  /// subscription keeps its data and can resume, so it is not folded into
  /// CANCELED.
  PAUSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /**
   * ISO 4217 code for every monetary amount in this organization. Bookings
   * store minor units (cents) with no currency of their own, so this is the
   * single place the app decides how to render them.
   */
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenancy relations
  users        User[]
  properties   Property[]
  subscription Subscription?
  invitations  Invitation[]
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String?
  role         Role          @default(OWNER)

  /**
   * TOTP second factor. The secret is encrypted at rest (AES-256-GCM, key
   * derived from AUTH_SECRET) — see lib/crypto.ts. `twoFactorEnabled` is only
   * set once the member has proved they can generate a valid code, so a
   * half-finished setup can never lock anyone out.
   */
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Which kinds of event this member wants to see in the activity feed.
  notifyCheckInsDue Boolean @default(true)
  notifyStaysEnding Boolean @default(true)
  notifyMissingRate Boolean @default(true)

  // Organization scoping
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sentInvitations Invitation[] @relation("InvitationSender")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/**
 * A one-time invitation link. The token is the only credential needed to join,
 * so it is single-use (`acceptedAt`), expires, and can be revoked — the accept
 * page refuses a token that is any of those.
 */
model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  role      Role     @default(MANAGER)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([email])
}

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  organization         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /**
   * Payment-provider identifiers. Lemon Squeezy is the provider; the names are
   * deliberately provider-neutral so swapping it later is a code change, not a
   * data migration. All nullable: an organization sits on the free STARTER tier
   * from registration and may never have been through a checkout at all.
   */
  billingCustomerId     String?            @unique
  billingSubscriptionId String?            @unique
  /// Lemon Squeezy variant id of the purchased plan.
  billingVariantId      String?

  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(ACTIVE)

  // Custom Overrides (For beta users, special enterprise deals, or free passes)
  maxPropertiesOverride Int?               // Null = use tier default, e.g., 999999 for unlimited
  hasApiAccessOverride  Boolean?           // Override feature flags manually
  isLifetimeFree        Boolean            @default(false)

  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

/**
 * Idempotency ledger for billing webhooks. Lemon Squeezy retries deliveries and
 * can deliver the same event more than once, so each event id is recorded and
 * replays are dropped rather than applied twice.
 */
model WebhookEvent {
  id         String   @id
  provider   String   @default("lemonsqueezy")
  type       String
  receivedAt DateTime @default(now())
}

model Property {
  id        String    @id @default(cuid())
  name      String
  address   String
  icalUrl   String?
  
  // Property belongs to Organization now, not individual User
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  guestName  String
  startDate  DateTime
  endDate    DateTime
  source     String   @default("Direct")
  status     BookingStatus @default(PENDING)
  /*
    Total booking value in the smallest currency unit (cents).
    Nullable on purpose: revenue metrics sum this and skip nulls rather than
    falling back to an estimate, so an unrecorded rate shows as "—" instead of
    presenting a fabricated figure as real.
  */
  totalAmount Int?
  createdAt  DateTime @default(now())
}